<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-base-entities" author="carebridge">
        <createTable tableName="base_entities">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parent_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_base_entities_parent"
                             references="base_entities(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="002-create-users" author="carebridge">
        <createTable tableName="users">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_users_base"
                             references="base_entities(id)"/>
            </column>
            <column name="name" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(255)"/>
            <column name="display_email" type="VARCHAR(255)"/>
            <column name="display_phone" type="VARCHAR(50)"/>
            <column name="internal_email" type="VARCHAR(255)"/>
            <column name="internal_phone" type="VARCHAR(50)"/>
        </createTable>
        <addUniqueConstraint tableName="users" columnNames="email" constraintName="uq_users_email"/>
    </changeSet>

    <changeSet id="003-create-residents" author="carebridge">
        <createTable tableName="resident">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_residents_base"
                             references="base_entities(id)"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="cpr_nr" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="004-create-journals" author="carebridge">
        <createTable tableName="journal">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_journals_base"
                             references="base_entities(id)"/>
            </column>
            <column name="resident_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_journals_resident"
                             references="resident(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="005-create-journal-entries" author="carebridge">
        <createTable tableName="journal_entries">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"
                             foreignKeyName="fk_journal_entries_base"
                             references="base_entities(id)"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_journal_entries_author"
                             references="users(id)"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="risk_assessment" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="entry_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="edit_close_time" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="journal_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_journal_entries_journal"
                             references="journal(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-create-guardian-residents" author="carebridge">
        <createTable tableName="guardian_residents">
            <column name="guardian_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_guardian_residents_guardian"
                             references="users(id)"/>
            </column>
            <column name="resident_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_guardian_residents_resident"
                             references="resident(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="guardian_residents" columnNames="guardian_id, resident_id"
                       constraintName="pk_guardian_residents"/>
    </changeSet>

    <changeSet id="007-create-resident-user" author="carebridge">
        <createTable tableName="resident_user">
            <column name="resident_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_resident_user_resident"
                             references="resident(id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_resident_user_user"
                             references="users(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="resident_user" columnNames="resident_id, user_id"
                       constraintName="pk_resident_user"/>
    </changeSet>

</databaseChangeLog>
